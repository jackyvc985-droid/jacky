# Copia este archivo a ".env" EN EL SERVIDOR y rellénalo. No subas el .env real a ningún repositorio.
API_DOMAIN=api.ejemplo.com                 # dominio que apunta a este servidor (propuesto: api.grupocanville.com; sin verificar)
ALLOWED_ORIGINS=https://app.ejemplo.com    # dónde se sirve la versión web de la app; no dejes "*" en producción
RATE_LIMIT=10
# Clave de cifrado (32 bytes en base64). Genérala con:  node scripts/genkey.mjs   y guárdala según docs/custodia-clave.md
DATA_KEY=
